{
	"name": "hono-mcp-stateless-http",
	"description": "Stateless HTTP middleware for Hono",
	"license": "MIT",
	"module": "index.ts",
	"type": "module",
	"files": ["index.ts", "dist"],
	"scripts": {
		"build": "",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"prepare": "simple-git-hooks"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/bun": "latest",
		"lint-staged": "^15.5.1",
		"simple-git-hooks": "^2.13.0"
	},
	"peerDependencies": {
		"hono": "^4.7.8",
		"typescript": "^5"
	},
	"trustedDependencies": ["@biomejs/biome", "simple-git-hooks"],
	"simple-git-hooks": {
		"pre-commit": "bun lint-staged"
	},
	"lint-staged": {
		"*": ["biome check --write --no-errors-on-unmatched"]
	}
}
